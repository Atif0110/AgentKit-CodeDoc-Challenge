# Lamatic credentials
LAMATIC_API_URL="https://api.lamatic.ai/v1"
LAMATIC_PROJECT_ID="your-lamatic-project-id"
LAMATIC_API_KEY="your-lamatic-api-key"

# Flow IDs (deploy in Lamatic Studio, then paste here)
